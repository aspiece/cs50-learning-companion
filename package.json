{
  "name": "cs50-learning-companion",
  "displayName": "CS50 Learning Companion",
  "description": "Guided, solution-free CS50P support inside GitHub Codespaces",
  "version": "0.9.0",
  "publisher": "geneseelearninglab",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onView:cs50Companion.sidebar",
    "onCommand:cs50Companion.createStarter",
    "onCommand:cs50Companion.checkForUpdates"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cs50Companion",
          "title": "CS50 Companion",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "cs50Companion": [
        {
          "id": "cs50Companion.sidebar",
          "name": "CS50 Problems",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "cs50Companion.createStarter",
        "title": "CS50 Companion: Create Starter Files"
      },
      {
        "command": "cs50Companion.openReleases",
        "title": "CS50 Companion: View Updates"
      },
      {
        "command": "cs50Companion.checkForUpdates",
        "title": "CS50 Companion: Check for Updates"
      }
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "package": "vsce package --no-dependencies",
    "verify:release": "node scripts/verify-release.js"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aspiece/cs50-learning-companion.git"
  },
  "bugs": {
    "url": "https://github.com/aspiece/cs50-learning-companion/issues"
  }
}
